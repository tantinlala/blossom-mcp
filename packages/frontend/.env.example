# Example environment configuration
# Copy this file to .env.development or .env.production and update the values

# Backend API URL
REACT_APP_API_URL=http://localhost:3030/api

# Realtime WebSocket URL. Leave unset unless the socket lives somewhere other
# than the API host: by default it is derived from REACT_APP_API_URL, so
# pointing the app at another machine moves both transports at once.
# REACT_APP_WS_URL=ws://localhost:3030/ws
